# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. .env.local is gitignored
# and must NEVER be committed. Restart the dev server after editing.
#
# The site runs fine with these blank: booking falls back to its static pricing
# and an open calendar, and /lux falls back to its built-in copy. Fill them in
# to go live.
# ---------------------------------------------------------------------------

# --- Hospitable (server-side only — these are SECRETS, never expose to client) ---
# Personal Access Token from the Hospitable dashboard (Settings -> API / Apps).
# Grants full account access, so it lives only in server code (app/api/*),
# never in NEXT_PUBLIC_* vars.
HOSPITABLE_API_TOKEN=
# The listing/property UUID this site books for.
HOSPITABLE_PROPERTY_ID=
# Optional override; defaults to Hospitable's public API base.
# HOSPITABLE_API_BASE=https://public.api.hospitable.com/v2

# --- Sanity (project id + dataset are public; the token is a secret) ---
# From `npm create sanity@latest` or manage.sanity.io. Safe to expose.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Only needed if the dataset is private or for draft/preview reads. Secret.
SANITY_API_READ_TOKEN=
# Only needed to run `npm run seed:lux` once (pushes /lux's built-in content
# into Sanity). Create an Editor token in manage.sanity.io, seed, then delete
# it. NOT needed for the site to run. Secret.
# SANITY_API_WRITE_TOKEN=
