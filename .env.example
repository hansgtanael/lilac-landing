# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. .env.local is gitignored
# and must NEVER be committed. Restart the dev server after editing.
#
# The site runs fine with these blank: booking falls back to its static pricing
# and an open calendar, and /lux falls back to its built-in copy. Fill them in
# to go live.
# ---------------------------------------------------------------------------

# --- Hospitable (server-side only — these are SECRETS, never expose to client) ---
# Personal Access Token from the Hospitable dashboard (Settings -> API / Apps).
# Grants full account access, so it lives only in server code (app/api/*),
# never in NEXT_PUBLIC_* vars.
HOSPITABLE_API_TOKEN=
# The listing/property UUID this site books for.
HOSPITABLE_PROPERTY_ID=
# Optional override; defaults to Hospitable's public API base.
# HOSPITABLE_API_BASE=https://public.api.hospitable.com/v2

# --- Sanity (project id + dataset are public; the token is a secret) ---
# From `npm create sanity@latest` or manage.sanity.io. Safe to expose.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Only needed if the dataset is private or for draft/preview reads. Secret.
SANITY_API_READ_TOKEN=
# Only needed to run `npm run seed:lux` once (pushes /lux's built-in content
# into Sanity). Create an Editor token in manage.sanity.io, seed, then delete
# it. NOT needed for the site to run. Secret.
# SANITY_API_WRITE_TOKEN=

# --- On-demand revalidation (instant CMS updates) ---
# Shared secret for the Sanity webhook that hits /api/revalidate. Generate one
# with: openssl rand -hex 32 — then set the SAME value here (on Netlify) and in
# the Sanity webhook config. Without it, updates still appear within ~60s. Secret.
SANITY_REVALIDATE_SECRET=

# --- FREE availability path: iCal feeds (alternative to the Hospitable API) ---
# Airbnb and Vrbo publish a read-only iCal feed of booked dates on every plan,
# at no cost. Comma-separated. Availability only — no pricing — and the
# platforms refresh roughly every 2-3h, so treat it as "looks taken", not a
# guarantee. Used only when the Hospitable API above is not configured.
#   Airbnb: Calendar -> Availability -> Connect calendars -> Export
#   Vrbo:   Calendar -> Import/Export -> Export
# Unguessable URLs that expose your booking pattern — treat as secret.
# ICAL_FEEDS=https://www.airbnb.com/calendar/ical/XXXX.ics?s=YYYY,https://www.vrbo.com/icalendar/ZZZZ.ics

# --- Booking inquiry delivery (REQUIRED for the booking form to work) ---
# Without all three the form returns an error telling the guest to email
# directly, rather than silently discarding the lead. Get a key at resend.com
# (free tier is ample for one property) and verify a sending domain.
# RESEND_API_KEY=
# INQUIRY_TO_EMAIL=owner@example.com
# INQUIRY_FROM_EMAIL=bookings@yourdomain.com
